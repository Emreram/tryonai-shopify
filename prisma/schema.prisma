// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Shop {
  id          String            @id @default(cuid())
  domain      String            @unique
  shopGid     String?           @unique
  installedAt DateTime          @default(now())
  settings    MerchantSettings?
  billing     BillingState?
}

model MerchantSettings {
  id                  String   @id @default(cuid())
  shop                String   @unique
  shopRef             Shop     @relation(fields: [shop], references: [domain], onDelete: Cascade)
  capOverride         Int?
  buttonLabel         String   @default("Try it on")
  accentColor         String   @default("#000000")
  allowedProductTypes String   @default("[]")
  cacheEnabled        Boolean  @default(true)
  // Per-shop kill switch for the AI Outfit Stylist (ships dark; enabled per shop
  // only after App Store approval, on top of the OUTFIT_FEATURE_ENABLED env flag).
  outfitEnabled       Boolean  @default(false)
  // Per-shop kill switch for the AI Size Recommender (ships dark; on top of the
  // SIZE_FEATURE_ENABLED env flag).
  sizeEnabled         Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model BillingState {
  id                   String    @id @default(cuid())
  shop                 String    @unique
  shopRef              Shop      @relation(fields: [shop], references: [domain], onDelete: Cascade)
  plan                 String    @default("trial")
  status               String    @default("active")
  subscriptionId       String?
  trialStartedAt       DateTime  @default(now())
  paidPlanStartedAt    DateTime?
  currentCycleStart    DateTime?
  currentCycleEnd      DateTime?
  monthlyCap           Int       @default(30)
  trialEndsAt          DateTime?
  currentCycleUsage    Int       @default(0)
  updatedAt            DateTime  @updatedAt
}

model UsageLog {
  id              String   @id @default(cuid())
  shop            String
  requestId       String   @unique
  openaiRequestId String?
  plan            String
  // What produced this row. "tryon" = an image generation (counts toward the
  // merchant's monthly cap). "outfit" = a gpt-5.4-mini outfit-selection call
  // (cheap text model; logged for COGS + as the cart-attribution anchor, but
  // EXCLUDED from the merchant cap — every cap/trial count filters kind:"tryon").
  kind            String   @default("tryon")
  costUsd         Float
  inputTokens     Int?
  outputTokens   Int?
  openaiMs        Int?
  billingEventId  String?
  billingEventStatus String?
  billingEventError String?
  status          String   @default("ok")
  size            String
  cycleStart      DateTime
  createdAt       DateTime @default(now())

  @@index([shop, cycleStart])
  @@index([createdAt])
  @@index([shop, status, cycleStart])
  @@index([shop, kind, status, cycleStart])
}

// Tool-driven add-to-cart attribution. One row per (try-on OR outfit) result a
// shopper added to their cart from the widget (extensions/tryon-button), reported
// by a signed app-proxy beacon AFTER the storefront /cart/add.js succeeds. Keyed
// by the originating `requestId` (a try-on generation OR an outfit-selection
// anchor) so it can only be written for a real, server-issued UsageLog row — this
// prevents arbitrary inflation. The unique key includes `variantId` so a single
// outfit (one `requestId` shared across its pieces) records ONE row per piece,
// while still being idempotent per piece. Holds NO customer-identifiable data:
// just the shop, the product/variant added, and the price captured at add time
// (the merchant's own catalog data). Powers the add-to-cart count + attributed
// cart value + estimated commission on /metrics.
model CartEvent {
  id            String   @id @default(cuid())
  shop          String
  requestId     String // the try-on or outfit request whose result was added (joins UsageLog.requestId)
  plan          String // plan at the time of the request (copied from the matched UsageLog row)
  productHandle String?
  variantId     String?
  quantity      Int      @default(1)
  unitPrice     Float? // per-unit price in shop-currency major units, at add time
  lineValue     Float? // quantity * unitPrice (denormalized for fast SUM)
  currency      String? // shop currency code at add time, e.g. "USD"
  cycleStart    DateTime // copied from the matched UsageLog row (the try-on's billing cycle)
  createdAt     DateTime @default(now())

  // (shop, requestId, variantId): one row per distinct piece of an outfit, still
  // idempotent per piece. NOTE: Postgres treats NULLs as distinct, so a null
  // variantId is de-duplicated in code (see recordCartEvent) rather than by this
  // constraint.
  @@unique([shop, requestId, variantId])
  @@index([shop, createdAt])
  @@index([createdAt])
}

model RateLimitBucket {
  key         String
  tier        String
  count       Int      @default(0)
  windowStart DateTime @default(now())
  expiresAt   DateTime

  @@id([key, tier])
  @@index([expiresAt])
}

// Result cache for try-on generations (masterplan A3). Stores a pointer to the
// generated image, which lives as a private object in Supabase Storage (EU,
// same region as the DB) — the bytes are NOT kept in Postgres. The cached image
// is customer likeness, so: keyed by a content hash (never by customer id),
// scoped by shop, and TTL'd via expiresAt (default 14 days). Purged on shop
// uninstall / shop redact and swept by a daily cron.
model TryOnCache {
  cacheKey    String   @id // sha256(promptVer|model|size|quality|shop|selfieHash|garmentIdentity)
  shop        String
  size        String
  promptVer   String
  model       String
  storagePath String // object path within the private Supabase Storage bucket
  bytes       Int
  hits        Int      @default(0)
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([shop])
  @@index([expiresAt])
}

// Per-shop normalized product index for the AI Outfit Stylist. Built from the
// shop's PUBLIC storefront data (no Admin API scope): /products.json (paginated)
// and /recommendations/products.json. `data` is the compact, normalized catalog
// the selection engine reasons over (handle, title, outfit slot, color family,
// price, image, in-stock variant ids) — NOT raw Shopify payloads, and NO customer
// data. One row per shop, TTL'd via expiresAt and rebuilt lazily so only the first
// outfit per shop per window pays the fetch cost. Purged on uninstall/shop redact.
model ShopCatalog {
  shop         String   @id
  // "full" = built from /products.json; "recommendations-only" = public feed was
  // disabled, anchored mode runs off /recommendations only; "unavailable" = no
  // usable public data (stylist hides itself for this shop).
  feedMode     String   @default("full")
  productCount Int      @default(0)
  data         Json
  builtAt      DateTime @default(now())
  expiresAt    DateTime

  @@index([expiresAt])
}
