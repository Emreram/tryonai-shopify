// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Shop {
  id          String            @id @default(cuid())
  domain      String            @unique
  shopGid     String?           @unique
  installedAt DateTime          @default(now())
  settings    MerchantSettings?
  billing     BillingState?
}

model MerchantSettings {
  id                  String   @id @default(cuid())
  shop                String   @unique
  shopRef             Shop     @relation(fields: [shop], references: [domain], onDelete: Cascade)
  capOverride         Int?
  buttonLabel         String   @default("Try it on")
  accentColor         String   @default("#000000")
  allowedProductTypes String   @default("[]")
  cacheEnabled        Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model BillingState {
  id                   String    @id @default(cuid())
  shop                 String    @unique
  shopRef              Shop      @relation(fields: [shop], references: [domain], onDelete: Cascade)
  plan                 String    @default("trial")
  status               String    @default("active")
  subscriptionId       String?
  trialStartedAt       DateTime  @default(now())
  paidPlanStartedAt    DateTime?
  currentCycleStart    DateTime?
  currentCycleEnd      DateTime?
  monthlyCap           Int       @default(30)
  trialEndsAt          DateTime?
  currentCycleUsage    Int       @default(0)
  updatedAt            DateTime  @updatedAt
}

model UsageLog {
  id              String   @id @default(cuid())
  shop            String
  requestId       String   @unique
  openaiRequestId String?
  plan            String
  costUsd         Float
  inputTokens     Int?
  outputTokens   Int?
  openaiMs        Int?
  billingEventId  String?
  billingEventStatus String?
  billingEventError String?
  status          String   @default("ok")
  size            String
  cycleStart      DateTime
  createdAt       DateTime @default(now())

  @@index([shop, cycleStart])
  @@index([createdAt])
  @@index([shop, status, cycleStart])
}

model RateLimitBucket {
  key         String
  tier        String
  count       Int      @default(0)
  windowStart DateTime @default(now())
  expiresAt   DateTime

  @@id([key, tier])
  @@index([expiresAt])
}

// Result cache for try-on generations (masterplan A3). Stores a pointer to the
// generated image, which lives as a private object in Supabase Storage (EU,
// same region as the DB) — the bytes are NOT kept in Postgres. The cached image
// is customer likeness, so: keyed by a content hash (never by customer id),
// scoped by shop, and TTL'd via expiresAt (default 14 days). Purged on shop
// uninstall / shop redact and swept by a daily cron.
model TryOnCache {
  cacheKey    String   @id // sha256(promptVer|model|size|quality|shop|selfieHash|garmentIdentity)
  shop        String
  size        String
  promptVer   String
  model       String
  storagePath String // object path within the private Supabase Storage bucket
  bytes       Int
  hits        Int      @default(0)
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([shop])
  @@index([expiresAt])
}
