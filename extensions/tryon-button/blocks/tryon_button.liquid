{{ 'tryon.css' | asset_url | stylesheet_tag }}

{% assign tryon_product_image = product.featured_image %}
{% if tryon_product_image == blank and product.selected_or_first_available_variant.featured_image %}
  {% assign tryon_product_image = product.selected_or_first_available_variant.featured_image %}
{% endif %}

{% assign tryon_variant_id = product.selected_or_first_available_variant.id %}
{% assign tryon_accent = block.settings.accent_color %}

{% assign tryon_combined = false %}
{% if block.settings.button_layout == 'combined' %}{% assign tryon_combined = true %}{% endif %}

{% if product %}
<div
  class="tryonai-root{% if tryon_combined %} tryonai-headless{% endif %}"
  data-stage="idle"
  data-theme="{{ block.settings.ui_theme | default: 'atelier' }}"
  data-button-shape="{{ block.settings.button_shape | default: 'pill' }}"
  data-product-handle="{{ product.handle }}"
  data-product-title="{{ product.title | escape }}"
  data-product-image-url="{% if tryon_product_image %}{{ tryon_product_image | image_url: width: 1024 }}{% endif %}"
  data-product-variant-id="{{ tryon_variant_id }}"
  {% if tryon_accent != blank %}style="--tryonai-accent: {{ tryon_accent }};"{% endif %}
  {{ block.shopify_attributes }}
>
  <button type="button" class="tryonai-launcher" aria-haspopup="dialog">
    <span class="tryonai-launcher__line">
      <span class="tryonai-launcher__text">{{ block.settings.button_label | default: 'Try it on' }}</span>
      <span class="tryonai-launcher__arrow" aria-hidden="true">
        <svg viewBox="0 0 28 12" width="28" height="12" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="square">
          <path d="M0 6h26M21 1l5 5-5 5"/>
        </svg>
      </span>
    </span>
  </button>

  <div class="tryonai-modal" hidden role="dialog" aria-modal="true" aria-labelledby="tryonai-title-{{ block.id }}">
    <div class="tryonai-scrim" data-action="dismiss" aria-hidden="true"></div>

    <div class="tryonai-panel" tabindex="-1">
      <header class="tryonai-topbar">
        <button type="button" class="tryonai-close" data-action="dismiss" aria-label="Close">
          <span class="tryonai-close__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square"><path d="M5 5l14 14M19 5L5 19"/></svg>
          </span>
        </button>
      </header>

      <div class="tryonai-live" aria-live="polite" aria-atomic="true"></div>

      <div class="tryonai-content">
        <!-- STAGE: COMPOSE -->
        <section class="tryonai-stage tryonai-stage--compose">
          <header class="tryonai-stage__header">
            <h2 id="tryonai-title-{{ block.id }}" class="tryonai-title">{{ block.settings.modal_title | default: 'Try it on' }}</h2>
            <p class="tryonai-sub">{{ block.settings.modal_subtitle | default: "Upload a photo and we'll show you wearing this item." }}</p>
          </header>

          <div class="tryonai-grid">
            <div class="tryonai-card tryonai-card--selfie">
              <span class="tryonai-card__label">Your photo</span>
              <label class="tryonai-drop">
                <input type="file" accept="image/jpeg,image/png,image/webp" class="tryonai-file-input" />
                <span class="tryonai-drop__icon" aria-hidden="true">
                  <svg viewBox="0 0 32 32" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="square">
                    <path d="M16 6v20M6 16h20"/>
                  </svg>
                </span>
                <span class="tryonai-drop__cta">Add your photo</span>
                <img class="tryonai-drop__preview" alt="" width="400" height="220" hidden />
                <button type="button" class="tryonai-drop__clear" data-action="clear-selfie" aria-label="Remove photo" hidden>
                  <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square"><path d="M5 5l14 14M19 5L5 19"/></svg>
                </button>
              </label>
              <p class="tryonai-card__hint">A clear photo of just you, facing the camera, works best.</p>
            </div>

            <div class="tryonai-card tryonai-card--item">
              <span class="tryonai-card__label">The garment</span>
              <div class="tryonai-item" data-detected="false">
                <div class="tryonai-item__thumb">
                  <img class="tryonai-item__image" alt="" width="110" height="138" />
                  <span class="tryonai-item__placeholder">
                    <span class="tryonai-item__placeholder-dot" aria-hidden="true"></span>
                    <span>Detecting</span>
                  </span>
                </div>
                <div class="tryonai-item__meta">
                  <div class="tryonai-item__title"></div>
                  <button type="button" class="tryonai-item__replace" data-action="replace-garment">Use a different photo &rarr;</button>
                </div>
              </div>
              <input type="file" accept="image/jpeg,image/png,image/webp" class="tryonai-garment-input" />
            </div>
          </div>

          <p class="tryonai-error" role="alert" hidden></p>
        </section>

        <!-- STAGE: GENERATING -->
        <section class="tryonai-stage tryonai-stage--generating" aria-hidden="true">
          <div class="tryonai-loom">
            <img class="tryonai-loom__selfie" alt="" width="280" height="420" />
            <img class="tryonai-loom__garment" alt="" width="280" height="420" />
            <span class="tryonai-loom__sweep" aria-hidden="true"></span>
            <div class="tryonai-loom__veil"></div>
          </div>
          <div class="tryonai-progress" aria-hidden="true">
            <span class="tryonai-glyph" aria-hidden="true">
              <svg class="tryonai-glyph__svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <g class="tryonai-glyph__paths"></g>
              </svg>
            </span>
            <div class="tryonai-progress__track">
              <div class="tryonai-progress__bar"></div>
            </div>
          </div>
          <p class="tryonai-status">
            <span class="tryonai-status__layer is-current">Reading your photo</span>
            <span class="tryonai-status__layer" aria-hidden="true"></span>
          </p>
        </section>

        <!-- STAGE: REVEAL -->
        <section class="tryonai-stage tryonai-stage--reveal" aria-hidden="true">
          <div class="tryonai-compare" style="--tryonai-split: 100%;">
            <img class="tryonai-compare__before" alt="Your photo" width="600" height="900" />
            <img class="tryonai-compare__after" alt="Try-on result" width="600" height="900" />
            <div class="tryonai-refine-bar" aria-hidden="true"></div>
            <span class="tryonai-compare__tag tryonai-compare__tag--before" aria-hidden="true">Before</span>
            <span class="tryonai-compare__tag tryonai-compare__tag--after" aria-hidden="true">After</span>
            <input
              type="range"
              class="tryonai-compare__slider"
              min="0"
              max="100"
              value="50"
              aria-label="Compare before and after"
            />
            <div class="tryonai-compare__handle" aria-hidden="true">
              <span class="tryonai-compare__handle-circle"></span>
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square"><path d="M9 6l-6 6 6 6M15 6l6 6-6 6"/></svg>
            </div>
          </div>
          <div class="tryonai-actions">
            <button type="button" class="tryonai-action" data-action="restart">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="square"><path d="M3 12a9 9 0 0 1 15.5-6.4L21 8M21 3v5h-5M21 12a9 9 0 0 1-15.5 6.4L3 16M3 21v-5h5"/></svg>
              <span>Try again</span>
            </button>
            <button type="button" class="tryonai-action" data-action="save">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="square"><path d="M12 4v12m0 0l-5-5m5 5l5-5M4 20h16"/></svg>
              <span>Save</span>
            </button>
            <button type="button" class="tryonai-action" data-action="share">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="square"><path d="M4 12v8h16v-8M16 6l-4-4-4 4M12 2v14"/></svg>
              <span>Share</span>
            </button>
            <button type="button" class="tryonai-action tryonai-action--primary" data-action="add-to-cart">
              <span>Add to cart</span>
              <span class="tryonai-action__arrow" aria-hidden="true">&rarr;</span>
            </button>
          </div>
        </section>
      </div>

      <footer class="tryonai-bottombar">
        <label class="tryonai-consent">
          <input type="checkbox" class="tryonai-consent-input" />
          <span class="tryonai-consent-box" aria-hidden="true">
            <svg class="tryonai-consent-tick" viewBox="0 0 16 12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M1.5 6.2l4 4L14.5 1.5"/>
            </svg>
          </span>
          <span class="tryonai-consent-text">I agree to processing my photo for this try-on. Your photo is sent to OpenAI for generation and is not stored by this app.</span>
        </label>

        <div class="tryonai-bottombar__cta">
          <button type="button" class="tryonai-cta" data-action="generate" disabled>
            <span class="tryonai-cta__label">Try it on</span>
            <span class="tryonai-cta__arrow" aria-hidden="true">
              <svg viewBox="0 0 28 12" width="28" height="12" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="square">
                <path d="M0 6h26M21 1l5 5-5 5"/>
              </svg>
            </span>
          </button>
        </div>
      </footer>
    </div>
  </div>
</div>

  {% comment %} AI Outfit Stylist + Size Recommender — ship dark; merchant opt-in
     via the block settings below. Both render on the shared kit so they look and
     load exactly like the try-on. {% endcomment %}
  {% if block.settings.show_outfit_button or block.settings.show_size_button or tryon_combined %}
    {{ 'tryonai-kit.css' | asset_url | stylesheet_tag }}
  {% endif %}

  {% if block.settings.show_outfit_button or tryon_combined %}
  {{ 'outfit.css' | asset_url | stylesheet_tag }}
  <div
    class="tryonai-outfit-root tryonai-kit{% if tryon_combined %} tryonai-headless{% endif %}"
    data-theme="{{ block.settings.ui_theme | default: 'atelier' }}"
    data-button-shape="{{ block.settings.button_shape | default: 'pill' }}"
    data-product-id="{{ product.id }}"
    data-product-handle="{{ product.handle }}"
    data-product-title="{{ product.title | escape }}"
    data-product-image-url="{% if tryon_product_image %}{{ tryon_product_image | image_url: width: 1024 }}{% endif %}"
    data-product-variant-id="{{ tryon_variant_id }}"
    {% if tryon_accent != blank %}style="--tryonai-accent: {{ tryon_accent }};"{% endif %}
    {{ block.shopify_attributes }}
  >
    <button type="button" class="tryonai-k-launcher" aria-haspopup="dialog">
      {% if block.settings.show_button_icon %}
      <span class="tryonai-k-launcher__glyph" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/><path d="M18.5 14.5l.7 2 2 .7-2 .7-.7 2-.7-2-2-.7 2-.7z"/></svg>
      </span>
      {% endif %}
      <span>{{ block.settings.outfit_button_label | default: 'Help me pick an outfit' }}</span>
    </button>
  </div>
  {% endif %}

  {% if block.settings.show_size_button or tryon_combined %}
  {{ 'size.css' | asset_url | stylesheet_tag }}
  <div
    class="tryonai-size-root tryonai-kit{% if tryon_combined %} tryonai-headless{% endif %}"
    data-theme="{{ block.settings.ui_theme | default: 'atelier' }}"
    data-button-shape="{{ block.settings.button_shape | default: 'pill' }}"
    data-product-id="{{ product.id }}"
    data-product-handle="{{ product.handle }}"
    data-product-title="{{ product.title | escape }}"
    data-product-image-url="{% if tryon_product_image %}{{ tryon_product_image | image_url: width: 1024 }}{% endif %}"
    data-product-variant-id="{{ tryon_variant_id }}"
    {% if tryon_accent != blank %}style="--tryonai-accent: {{ tryon_accent }};"{% endif %}
    {{ block.shopify_attributes }}
  >
    <button type="button" class="tryonai-k-launcher" aria-haspopup="dialog">
      {% if block.settings.show_button_icon %}
      <span class="tryonai-k-launcher__glyph" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h16v8H4z"/><path d="M8 8v3M12 8v4M16 8v3"/></svg>
      </span>
      {% endif %}
      <span>{{ block.settings.size_button_label | default: 'Find my size' }}</span>
    </button>
  </div>
  {% endif %}

  {% comment %} Combined launcher: one button that opens a chooser for the
     enabled tools. The feature roots above still render (headless) so their JS
     inits; their own buttons are hidden via CSS. {% endcomment %}
  {% if tryon_combined %}
  <div
    class="tryonai-combined-root tryonai-kit"
    data-theme="{{ block.settings.ui_theme | default: 'atelier' }}"
    data-button-shape="{{ block.settings.button_shape | default: 'pill' }}"
    data-block-id="{{ block.id }}"
    data-show-icon="{{ block.settings.show_button_icon }}"
    data-chooser-title="{{ block.settings.chooser_title | default: 'What would you like to do?' | escape }}"
    data-label-tryon="{{ block.settings.button_label | default: 'Try it on' | escape }}"
    data-label-outfit="{{ block.settings.outfit_button_label | default: 'Help me pick an outfit' | escape }}"
    data-label-size="{{ block.settings.size_button_label | default: 'Find my size' | escape }}"
    {% if tryon_accent != blank %}style="--tryonai-accent: {{ tryon_accent }};"{% endif %}
    {{ block.shopify_attributes }}
  >
    <button type="button" class="tryonai-k-launcher tryonai-combined-launcher" aria-haspopup="dialog">
      {% if block.settings.show_button_icon %}
      <span class="tryonai-k-launcher__glyph" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/><path d="M18.5 14.5l.7 2 2 .7-2 .7-.7 2-.7-2-2-.7 2-.7z"/></svg>
      </span>
      {% endif %}
      <span>{{ block.settings.combined_button_label | default: 'Style me with AI' }}</span>
    </button>
  </div>
  {% endif %}
{% endif %}

{% if block.settings.show_outfit_button or block.settings.show_size_button or tryon_combined %}
  <script src="{{ 'tryonai-kit.js' | asset_url }}" defer></script>
{% endif %}
{% if block.settings.show_size_button or tryon_combined %}<script src="{{ 'size.js' | asset_url }}" defer></script>{% endif %}
{% if block.settings.show_outfit_button or tryon_combined %}<script src="{{ 'outfit.js' | asset_url }}" defer></script>{% endif %}

<script src="{{ 'tryon.js' | asset_url }}" defer></script>
{% if tryon_combined %}<script src="{{ 'combined.js' | asset_url }}" defer></script>{% endif %}

{% schema %}
{
  "name": "AI Try-On Button",
  "target": "section",
  "settings": [
    {
      "type": "select",
      "id": "ui_theme",
      "label": "Style",
      "info": "Visual look of the try-on button and modal. Only you (the store owner) can change this; shoppers can't.",
      "options": [
        { "value": "atelier", "label": "Atelier — warm linen (default)" },
        { "value": "noir", "label": "Noir — midnight dark" },
        { "value": "gallery", "label": "Gallery — clean minimal" }
      ],
      "default": "atelier"
    },
    {
      "type": "select",
      "id": "button_shape",
      "label": "Button shape",
      "info": "Corner style of the Try-on button. Shoppers can't change this.",
      "options": [
        { "value": "pill", "label": "Pill — fully rounded (default)" },
        { "value": "rounded", "label": "Rectangle — soft corners" },
        { "value": "square", "label": "Rectangle — sharp corners" }
      ],
      "default": "pill"
    },
    {
      "type": "checkbox",
      "id": "show_button_icon",
      "label": "Show AI icon on buttons",
      "info": "Turn this off to hide the small AI/sparkle icon on the buttons (the combined button, the outfit button, and the size button). The text label stays.",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Try it on"
    },
    {
      "type": "text",
      "id": "modal_title",
      "label": "Modal title",
      "default": "Try it on"
    },
    {
      "type": "text",
      "id": "modal_subtitle",
      "label": "Modal subtitle",
      "default": "Upload a photo and we'll show you wearing this item."
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color (optional — overrides the style's accent)"
    },
    {
      "type": "header",
      "content": "Button layout"
    },
    {
      "type": "select",
      "id": "button_layout",
      "label": "How buttons appear",
      "info": "Separate (default) shows each enabled feature as its own button. Combined shows one button that opens a chooser so shoppers pick Virtual Try-On, the Outfit Stylist, or the Size Recommender. Combined only groups the features you've turned on below.",
      "options": [
        { "value": "separate", "label": "Separate buttons (default)" },
        { "value": "combined", "label": "One combined button with a chooser" }
      ],
      "default": "separate"
    },
    {
      "type": "text",
      "id": "combined_button_label",
      "label": "Combined button label",
      "info": "Shown only when \"One combined button\" is selected.",
      "default": "Style me with AI"
    },
    {
      "type": "text",
      "id": "chooser_title",
      "label": "Chooser heading",
      "info": "Shown at the top of the chooser when more than one feature is enabled.",
      "default": "What would you like to do?"
    },
    {
      "type": "header",
      "content": "AI Outfit Stylist (beta)"
    },
    {
      "type": "checkbox",
      "id": "show_outfit_button",
      "label": "Show the \"Help me pick an outfit\" button",
      "info": "Adds an AI stylist that builds a full outfit from your catalog and lets shoppers try the whole look on. Leave this OFF until you've been told the feature is live for your store.",
      "default": false
    },
    {
      "type": "text",
      "id": "outfit_button_label",
      "label": "Outfit button label",
      "default": "Help me pick an outfit"
    },
    {
      "type": "header",
      "content": "AI Size Recommender (beta)"
    },
    {
      "type": "checkbox",
      "id": "show_size_button",
      "label": "Show the \"Find my size\" button",
      "info": "Adds an AI size finder: the shopper enters their measurements once and gets a recommended size per product. Leave this OFF until you've been told the feature is live for your store.",
      "default": false
    },
    {
      "type": "text",
      "id": "size_button_label",
      "label": "Size button label",
      "default": "Find my size"
    }
  ]
}
{% endschema %}
