# Copy this file to .env (gitignored) and fill in real values.
# .env is loaded automatically by `shopify app dev`.

# Required: OpenRouter API key. This is the ONLY model credential the app needs
# — both the gpt-image-2 try-on renders (POST /api/v1/images) and the
# gpt-5.4-mini structured-text calls (POST /api/v1/chat/completions) go through
# it. Create one at https://openrouter.ai/keys and fund the account; OpenRouter
# answers an unfunded key with HTTP 402, which the app logs as
# `error_code: "billing"`. Install it with: scripts/set-openrouter-key.sh
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: override the structured-text model slug (organisation prefix
# required, e.g. "openai/gpt-5.4-mini" or "anthropic/claude-haiku-4.5"). Only
# used by the Outfit Stylist and Size Recommender, which ship dark.
OUTFIT_TEXT_MODEL=

# Global daily kill switch (USD). When today's summed UsageLog.costUsd reaches
# this value, /apps/tryonai/tryon returns 503 service_paused for every shop —
# this is the bankruptcy fuse if generation cost runs away. Leave empty or 0
# to disable.
DAILY_COST_CEILING_USD=

# Per-shopper rate limit applied BEFORE the plan-cap check, so blocked
# requests never count against a merchant's purchased quota. Two tiers per
# (shop, customer-id-or-hashed-ip) key. Defaults shown; raise the IP-fallback
# limit later if shared-NAT cases surface in logs (event: "rate_limit_hit").
RATE_LIMIT_SHORT_COUNT=20
RATE_LIMIT_SHORT_MS=900000
RATE_LIMIT_HOUR_COUNT=60
RATE_LIMIT_HOUR_MS=3600000

# Owner-only profit dashboard password. When set, /metrics shows a login form;
# the correct password renders the global profit dashboard (every shop's
# try-ons, exact COGS, estimated revenue, profit). When EMPTY/unset, /metrics
# returns 404 (dashboard disabled). Use a long random string, e.g.
# `openssl rand -hex 32`. This is YOUR password — not a Shopify credential.
OWNER_DASHBOARD_SECRET=

# Commission rate (PERCENT) applied to tool-driven add-to-cart value to produce
# the "estimated commission income" figure on /metrics. Default 5 — chosen by
# market research (rationale in app/lib/commission.ts): the base is cart-adds,
# not confirmed orders (~70% of carts are abandoned), so this is an illustrative
# what-if ceiling, not booked revenue. Leave empty to use the default; set a
# number in [0,100] to override without a redeploy. Example: 5
TRYON_COMMISSION_PCT=

# Shopify CLI manages these automatically during `shopify app dev`:
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SHOPIFY_APP_URL=
# Production/Preview SCOPES in Vercel should match shopify.app.toml.
SCOPES=

# Shopify App Pricing hosted plan page. MUST match the app handle on Shopify's
# side (the `<handle>` in admin .../charges/<handle>/pricing_plans). For this
# app that is `tryonaishopfy`, NOT `tryonai`. Subscription status is read live
# from the Admin API (currentAppInstallation.activeSubscriptions), so no Partner
# API credentials are needed anymore.
SHOPIFY_APP_HANDLE=tryonaishopfy

# Shopify App Events API, used for App Pricing usage meters.
SHOPIFY_APP_EVENTS_CLIENT_ID=
SHOPIFY_APP_EVENTS_CLIENT_SECRET=
SHOPIFY_APP_EVENTS_API_VERSION=unstable

# Public marketing-landing CTA. Set to the live Shopify App Store listing URL
# once published (e.g. https://apps.shopify.com/tryonai). Only URLs whose host
# is apps.shopify.com are honored; any other value is ignored and the landing
# falls back to a no-link "install from the App Store" message. Must be set in
# the production environment (Vercel) before submitting for App Store review.
APP_STORE_LISTING_URL=

# Supabase Postgres. Get both URLs from Supabase dashboard -> Settings -> Database.
# DATABASE_URL must be the TRANSACTION POOLER (port 6543) so Vercel serverless
# functions survive cold starts without exhausting Postgres connections.
# DIRECT_URL must be the DIRECT connection (port 5432) — Prisma uses it for
# `prisma migrate` only (PgBouncer transaction mode breaks Prisma's prepared
# statements during migrations).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Try-on result cache (masterplan A3) ---------------------------------------
# Caches generated try-on images so repeat/QA/retry requests are instant and free
# (no OpenAI spend). The cached image is CUSTOMER LIKENESS: it is content-hashed
# (never keyed by customer id), shop-scoped, TTL'd, and stored in a PRIVATE
# Supabase Storage bucket in the SAME EU region as the DB. The cache only turns on
# when ALL of: TRYON_CACHE_ENABLED=true, the SUPABASE_* creds below are set, and
# the merchant hasn't opted out (MerchantSettings.cacheEnabled). Ships dark.
TRYON_CACHE_ENABLED=
# Supabase project URL (e.g. https://<project-ref>.supabase.co) and the SERVICE
# ROLE key (Settings -> API). The service-role key bypasses RLS — server-only,
# never expose to the browser or the theme extension.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Private Storage bucket name (create it once, public=false). Default tryon-cache.
TRYON_CACHE_BUCKET=tryon-cache
# Days to retain a cached image before the daily cron sweep deletes it. Default 14.
TRYON_CACHE_TTL_DAYS=14
# Shared secret for the /api/cache-cleanup cron route. Set the SAME value as a
# Vercel Cron secret; Vercel sends it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# --- AI Outfit Stylist ---------------------------------------------------------
# Ships dark. Master switch: the /apps/tryonai/outfit* endpoints 404 unless this
# is exactly "true". The storefront button additionally requires the merchant to
# enable the theme block setting. Keep OFF until the App Store review clears.
OUTFIT_FEATURE_ENABLED=
# When the master switch is on, a shop is served only if MerchantSettings.outfitEnabled
# is true for it (pilot rollout). Set this to "true" to enable for ALL shops at once
# (global rollout) without flipping each shop's flag.
OUTFIT_FEATURE_ALL_SHOPS=
# The "thinking" model for outfit selection + product classification (owner-specified).
# Pin to a dated snapshot for stability. Default: gpt-5.4-mini.
OUTFIT_TEXT_MODEL=gpt-5.4-mini
# Reasoning effort for the selection model: minimal | low | medium | high. Default low
# (keeps a typical outfit well under $0.01). Higher = better picks, more cost/latency.
OUTFIT_REASONING_EFFORT=low
# Max pieces in an outfit, including the anchor. 2-5, default 4.
OUTFIT_MAX_PIECES=4
# Set to "false" to skip the gpt-5.4-mini classification of products the heuristics
# couldn't categorize (cheaper builds, slightly worse slot coverage). Default on.
OUTFIT_LLM_CLASSIFY=
# Set to "false" to skip the LLM coherent-pick step and rely purely on the
# deterministic color-theory selector. Default on.
OUTFIT_LLM_SELECT=
# Max /products.json pages (250 products each) fetched when building a shop's index.
# Default 8 (2000 products). Raise for very large catalogs (costs build latency).
OUTFIT_CATALOG_MAX_PAGES=8
# Hours to cache a shop's built product index before a lazy rebuild. Default 24.
OUTFIT_CATALOG_TTL_HOURS=24

# --- AI Size Recommender -------------------------------------------------------
# Ships dark. Master switch: the /apps/tryonai/size endpoint 404s unless this is
# exactly "true". The storefront "Find my size" button also requires the merchant
# to enable the theme block setting. Keep OFF until the App Store review clears.
SIZE_FEATURE_ENABLED=
# When the master switch is on, a shop is served only if MerchantSettings.sizeEnabled
# is true for it. Set this to "true" to enable for ALL shops at once.
SIZE_FEATURE_ALL_SHOPS=
