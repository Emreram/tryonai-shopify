# Copy this file to .env (gitignored) and fill in real values.
# .env is loaded automatically by `shopify app dev`.

# Required: OpenAI API key with access to gpt-image-2-2026-04-21
OPENAI_API_KEY=sk-...

# Global daily kill switch (USD). When today's summed UsageLog.costUsd reaches
# this value, /apps/tryonai/tryon returns 503 service_paused for every shop —
# this is the bankruptcy fuse if generation cost runs away. Leave empty or 0
# to disable.
DAILY_COST_CEILING_USD=

# Per-shopper rate limit applied BEFORE the plan-cap check, so blocked
# requests never count against a merchant's purchased quota. Two tiers per
# (shop, customer-id-or-hashed-ip) key. Defaults shown; raise the IP-fallback
# limit later if shared-NAT cases surface in logs (event: "rate_limit_hit").
RATE_LIMIT_SHORT_COUNT=20
RATE_LIMIT_SHORT_MS=900000
RATE_LIMIT_HOUR_COUNT=60
RATE_LIMIT_HOUR_MS=3600000

# Shopify CLI manages these automatically during `shopify app dev`:
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SHOPIFY_APP_URL=
# Production/Preview SCOPES in Vercel should match shopify.app.toml.
SCOPES=read_orders

# Public marketing-landing CTA. Set to the live Shopify App Store listing URL
# once published (e.g. https://apps.shopify.com/tryonai). Only URLs whose host
# is apps.shopify.com are honored; any other value is ignored and the landing
# falls back to a no-link "install from the App Store" message. Must be set in
# the production environment (Vercel) before submitting for App Store review.
APP_STORE_LISTING_URL=

# Supabase Postgres. Get both URLs from Supabase dashboard -> Settings -> Database.
# DATABASE_URL must be the TRANSACTION POOLER (port 6543) so Vercel serverless
# functions survive cold starts without exhausting Postgres connections.
# DIRECT_URL must be the DIRECT connection (port 5432) — Prisma uses it for
# `prisma migrate` only (PgBouncer transaction mode breaks Prisma's prepared
# statements during migrations).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
